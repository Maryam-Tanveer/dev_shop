# ==============================================================================
# DEV SHOP — STREETWEAR DROP VAULT BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
# Default connects to local MongoDB, or provide MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/devshop

# JSON Web Token (JWT) Security
# IMPORTANT: Generate a cryptographically secure key with at least 32 characters for production
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated list or *)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# API Rate Limiting Configuration
# RATE_LIMIT_WINDOW_MS: Window size in milliseconds (e.g. 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=30

# Stripe Payments (Secret Key)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Email Receipts & Notifications (Nodemailer / SMTP)
# If left blank, operates in development mode with Ethereal preview links logged to console
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_specific_password
EMAIL_FROM="Dev Shop Vault <receipts@devshop.io>"
FRONTEND_URL=http://localhost:5173
